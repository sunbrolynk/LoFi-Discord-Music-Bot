# Discord Bot Configuration (Required)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Spotify Web API Credentials (Required for Spotify track/playlist resolution)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Default 24/7 Fallback Lofi Radio Stream (Icecast/MP3/HLS URL)
DEFAULT_FALLBACK_STREAM_URL=https://lofi.radio/

# Backup stations tried in order when a server's own fallback is down (comma-separated)
BACKUP_FALLBACK_STREAM_URLS=https://stream.laut.fm/lofi

# Persistent SQLite Database Path & Logging
# Logs and the healthcheck heartbeat live in the same folder, so give each copy of the bot its own
DATABASE_PATH=data/lofi_bot.db
LOG_LEVEL=INFO

# Radio-only mode (optional): set RADIO_STREAM_URL to play only this stream in RADIO_CHANNEL_ID
# (the voice channel's numeric ID). Playlist commands are turned off while it's set.
RADIO_STREAM_URL=
RADIO_CHANNEL_ID=
# AzuraCast now-playing JSON, polled every 30s for the "Listening to" status (optional)
RADIO_NOWPLAYING_URL=

# Discord Bot Configuration (Required)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Spotify Web API Credentials (Required for Spotify track/playlist resolution)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Default 24/7 Fallback Lofi Radio Stream (Icecast/MP3/HLS URL)
DEFAULT_FALLBACK_STREAM_URL=https://lofi.radio/

# Backup stations tried in order when a server's own fallback is down (comma-separated)
BACKUP_FALLBACK_STREAM_URLS=https://stream.laut.fm/lofi

# Persistent SQLite Database Path & Logging
DATABASE_PATH=data/lofi_bot.db
LOG_LEVEL=INFO